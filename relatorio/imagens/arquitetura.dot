digraph Arquitetura {
  graph [
    rankdir=TB,
    fontname="DejaVu Sans",
    fontsize=11,
    bgcolor="white",
    pad=0.3,
    nodesep=0.5,
    ranksep=0.75,
    splines=ortho,
    dpi=300
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=10,
    margin="0.16,0.10",
    penwidth=1.3
  ];
  edge [
    fontname="DejaVu Sans",
    fontsize=8.5,
    color="#334155",
    fontcolor="#1e293b",
    arrowsize=0.75,
    penwidth=1.2
  ];

  subgraph cluster_net {
    label="Rede Virtual Docker: monitoring-net (bridge)";
    labeljust="l";
    style="rounded,dashed";
    color="#1d4ed8";
    fontcolor="#1e3a8a";
    bgcolor="#f8fafc";
    penwidth=1.5;

    subgraph cluster_carga {
      label="Geração de Carga";
      style="rounded";
      color="#b45309";
      fontcolor="#92400e";
      bgcolor="#fffbeb";

      locust [
        label="locust-load-test\n(locustio/locust)\nPorta 8089\nlocust_alunos.py | locust_atividades.py",
        fillcolor="#fef3c7",
        color="#d97706"
      ];
    }

    subgraph cluster_app {
      label="Sistema Alvo (Ambiente Local Isolado)";
      style="rounded";
      color="#15803d";
      fontcolor="#166534";
      bgcolor="#f0fdf4";

      app [
        label="app-educacional (CreateJoy)\n(php:8.3-apache)\nPorta 8000\n/api/index.php | /metrics/index.php",
        fillcolor="#dcfce7",
        color="#16a34a"
      ];
      db [
        label="db-educacional\n(mariadb:11.4)\nInterna 3306 | Host 5432",
        fillcolor="#dcfce7",
        color="#16a34a"
      ];
    }

    subgraph cluster_obs {
      label="Pilha de Observabilidade";
      style="rounded";
      color="#0369a1";
      fontcolor="#075985";
      bgcolor="#f0f9ff";

      cadvisor [
        label="cadvisor\n(v0.61.1)\nPorta 8080\nMétricas de Containers",
        fillcolor="#e0f2fe",
        color="#0284c7"
      ];
      node_exp [
        label="node-exporter\n(v1.8.2)\nPorta 9100\nMétricas do SO Hospedeiro",
        fillcolor="#e0f2fe",
        color="#0284c7"
      ];
      prometheus [
        label="prometheus\n(v2.55.1)\nPorta 9090\nScrape 5s | Retenção 7d",
        fillcolor="#bae6fd",
        color="#0369a1"
      ];
      grafana [
        label="grafana\n(11.3.1)\nPorta 3000\nDashboard Observabilidade CreateJoy",
        fillcolor="#bae6fd",
        color="#0369a1"
      ];
    }
  }

  subgraph cluster_vol {
    label="Volumes Persistentes (Docker Volumes)";
    labeljust="l";
    style="rounded";
    color="#6d28d9";
    fontcolor="#5b21b6";
    bgcolor="#faf5ff";

    vol_db [label="db_data\n(/var/lib/mysql)", shape=cylinder, fillcolor="#ede9fe", color="#7c3aed"];
    vol_prom [label="prometheus_data\n(/prometheus)", shape=cylinder, fillcolor="#ede9fe", color="#7c3aed"];
    vol_graf [label="grafana_data\n(/var/lib/grafana)", shape=cylinder, fillcolor="#ede9fe", color="#7c3aed"];
  }

  locust -> app [xlabel="  HTTP :8000"];
  app -> db [xlabel="  PDO/MySQL :3306"];

  prometheus -> app [xlabel="scrape 5s\n/metrics/index.php"];
  prometheus -> cadvisor [xlabel="scrape 5s\n:8080"];
  prometheus -> node_exp [xlabel="scrape 5s\n:9100"];
  grafana -> prometheus [xlabel="PromQL :9090"];

  db -> vol_db [style=dashed, color="#7c3aed"];
  prometheus -> vol_prom [style=dashed, color="#7c3aed"];
  grafana -> vol_graf [style=dashed, color="#7c3aed"];
}
